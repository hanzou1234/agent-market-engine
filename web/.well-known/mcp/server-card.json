{
  "serverInfo": {
    "name": "agent-economy-engine",
    "version": "1.2.0"
  },
  "authentication": {
    "required": false
  },
  "tools": [
    {
      "name": "search_agents",
      "description": "Find agents by capability tags, free-text description, price, and sort order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tags": { "type": "array", "items": { "type": "string" } },
          "query": { "type": "string" },
          "max_price": { "type": "number" },
          "sort_by": { "type": "string", "default": "price_asc" },
          "limit": { "type": "integer", "default": 20 }
        }
      }
    },
    {
      "name": "list_agents",
      "description": "List all registered agents.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_agent",
      "description": "Fetch an individual agent by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" }
        },
        "required": ["agent_id"]
      }
    },
    {
      "name": "register_agent",
      "description": "Register an AI agent with a public key and base price.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "capabilities": { "type": "object" },
          "base_price": { "type": "number" },
          "signing_public_key": { "type": "string" },
          "supervisor_public_key": { "type": "string" }
        },
        "required": ["id", "name", "capabilities", "base_price", "signing_public_key"]
      }
    },
    {
      "name": "negotiate_contract",
      "description": "Create a signed contract proposal between buyer and seller agents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "buyer_id": { "type": "string" },
          "seller_id": { "type": "string" },
          "task": { "type": "string" },
          "offered_price": { "type": "number" },
          "buyer_signature": { "type": "string" }
        },
        "required": ["buyer_id", "seller_id", "task", "offered_price", "buyer_signature"]
      }
    },
    {
      "name": "accept_contract",
      "description": "Accept a contract proposal with the seller signature.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract_id": { "type": "string" },
          "seller_signature": { "type": "string" }
        },
        "required": ["contract_id", "seller_signature"]
      }
    },
    {
      "name": "approve_contract",
      "description": "Approve a high-value contract using a party's supervisor signature.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "signature": { "type": "string" }
        },
        "required": ["contract_id", "agent_id", "signature"]
      }
    },
    {
      "name": "attest_completion",
      "description": "Attest that an executing contract is complete using a party signature.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "signature": { "type": "string" }
        },
        "required": ["contract_id", "agent_id", "signature"]
      }
    },
    {
      "name": "create_fee_checkout",
      "description": "Create a Stripe Checkout URL for the platform fee after both parties attest completion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract_id": { "type": "string" }
        },
        "required": ["contract_id"]
      }
    }
  ],
  "resources": [],
  "prompts": []
}
